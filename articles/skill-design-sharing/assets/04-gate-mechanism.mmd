config:
  theme: neutral
  themeVariables:
    fontSize: "15px"
    fontFamily: "PingFang SC, Helvetica, sans-serif"
---
flowchart TB
    Start(["AI 收集到部分用户输入"]) --> Submit["提交 gate-data 给 CLI"]
    Submit --> Check{"CLI 校验<br/>schema"}

    Check -->|缺少 required 字段| Fail["返回缺失字段清单<br/>例: 缺少 host"]
    Fail --> AskUser["AI 知道还差什么<br/>回去找用户补问"]
    AskUser --> Submit

    Check -->|有 schema 没定义的字段| Drop["丢弃多余字段<br/>AI 不会被引导收集无关信息"]
    Drop --> Pass

    Check -->|全部满足| Pass["✓ 通过"]
    Pass --> Save["持久化到 state.gates<br/>推进到下一步"]

    style Fail fill:#fed7d7,stroke:#e53e3e
    style Drop fill:#fefcbf,stroke:#d69e2e
    style Pass fill:#c6f6d5,stroke:#38a169
    style Save fill:#bee3f8,stroke:#3182ce
